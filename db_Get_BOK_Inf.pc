#include "tcp_iso.h"

EXEC SQL INCLUDE sqlca;
//EXEC SQL INCLUDE    "table/tb_clc_code_dtl_pt.h";

// 0 : BOK (국고)
// 1 : FTP (신한은망)
int dbGetIDPW( )
{
  EXEC SQL BEGIN DECLARE SECTION;
  int rc =0;
  char dtl_cd  [128+1];
  char dtl_cd_cntn1  [128+1];
  char dtl_cd_cntn2  [128+1];
  EXEC SQL END DECLARE SECTION;

  memset( dtl_cd, 0x00, sizeof( dtl_cd ) );
  memset( dtl_cd_cntn1, 0x00, sizeof( dtl_cd_cntn1 ) );
  memset( dtl_cd_cntn2, 0x00, sizeof( dtl_cd_cntn2 ) );

  memcpy(dtl_cd, "BOK_IDPW", 8 );  

  if( strcmp( gc_BizCode, "BOK" ) == 0 ) {    
    // 0 : BOK (국고)
    memcpy(dtl_cd, "BOK", 3 );  
  } else {
    // 1 : FTP (신한은망)
    memcpy(dtl_cd, "FTP", 3 );  
  }	

  EXEC SQL SELECT DTL_CD_CNTN1, DTL_CD_CNTN2
    INTO :dtl_cd_cntn1, :dtl_cd_cntn2
    FROM TB_CLC_CODE_DTL
    WHERE MST_CD = 'BOK_IDPW'
    AND DTL_CD = :dtl_cd
    ;

  if( SQLCODE != SQL_OK )
  {
    ulog(_ERROR_, "[장애로그] 한국은행 ID / PW 취득 오류 [SQL_NO:%d] for BIZ[%s] DTL_CD[%s] ID[%s] PW[%s]", 
        SQLCODE, gc_BizCode, dtl_cd, dtl_cd_cntn1, dtl_cd_cntn2);
    return -1;
  }

  memset( gc_plain_id, 0x00, sizeof( gc_plain_id ) );
  memcpy( gc_plain_id, dtl_cd_cntn1, strlen(dtl_cd_cntn1) );

  memset( gc_plain_pw, 0x00, sizeof( gc_plain_pw ) );
  memcpy( gc_plain_pw, dtl_cd_cntn2, strlen(dtl_cd_cntn2) );

  return 0;
}

int dbUpdateIDPW(char* pID, char* pPass)
{
  EXEC SQL BEGIN DECLARE SECTION;
  char	cid[32+1];
  char	cpass[32+1];
  char	cBiz[32+1];
  EXEC SQL END DECLARE SECTION;

  ulog(_FLOW_, "BIZ/ID/PW :%s/%s/%s", gc_BizCode, pID, pPass );

  memset(cid, 0x00, sizeof(cid));
  memcpy(cid, pID, strlen(pID));

  memset(cpass, 0x00, sizeof(cpass));
  memcpy(cpass, pPass, strlen(pPass));

  memset(cBiz, 0x00, sizeof(cBiz));
  if( strcmp( gc_BizCode, "BOK" ) == 0 ) {    
    // 0 : BOK     (국고)
    memcpy( cBiz, "BOK", 3 );  
  } else {
    // 1 : NEW BOK (신한은망)
    memcpy( cBiz, "FTP", 3 );  
  }

  EXEC SQL UPDATE TB_CLC_CODE_DTL
    SET	DTL_CD_CNTN1 = :cid,
        DTL_CD_CNTN2 = :cpass
    WHERE MST_CD	=	'BOK_IDPW'
    AND	DTL_CD	=	:cBiz
    ;

  if( SQLCODE != SQL_OK )
  {
    ulog(_ERROR_, "[장애로그] 한국은행 ID / PW Update 오류 [SQL_NO:%d] for BIZ[%s] ID[%s] PW[%s]", 
        SQLCODE, cBiz, cid, cpass);
    EXEC SQL ROLLBACK;
  }

  EXEC SQL COMMIT;

  return 0;
}

int getEncIdPw( )
{
  int inlen=0;
  int outlen=0;
  int rc;
  int offset;
  unsigned char* pOut = NULL;

  memset(gc_EncIdPswd, 0x0, sizeof( gc_EncIdPswd ) );
  memset(gc_PlainIdPswd, 0x20, sizeof( gc_PlainIdPswd ) );
  gc_PlainIdPswd[32] = 0;

  if( strcmp( gc_BizCode, "BOK" ) == 0 ) {    
    // 0 : BOK     (국고)
    offset = 20;
    inlen = 28;
  } else {
    // 1 : NEW BOK (신한은망)
    offset = 16;
    inlen = 32;
  }

  // copy id, pswd
  memcpy( gc_PlainIdPswd, 	   gc_plain_id, strlen( gc_plain_id ) );
  memcpy( gc_PlainIdPswd+offset, gc_plain_pw, strlen( gc_plain_pw ) );

  // 20200408 : Encrypt 안 할 경우
  if( g_Encrypt_Flag == 0 ) {
    memcpy( gc_EncIdPswd, gc_PlainIdPswd, strlen( gc_PlainIdPswd ) );
    return 0;
  }

  rc = inl_encrypt(gc_PlainIdPswd, inlen, (char**)&pOut, &outlen);
  if( rc < 0 )
  {
    ulog(_ERROR_, "[장애로그] : ID/PSWD Encrypt 오류 BIZ[%s] [%d]", gc_BizCode, rc);
    return -2;
  }

  // copy encrypted id, pswd
  memcpy( gc_EncIdPswd, pOut, outlen );

  return 0;
}

int getPlainIdPw( )
{
  int outlen=0;
  int inlen=0;
  int rc;
  int offset;
  unsigned char* pOut;

  if( strcmp( gc_BizCode, "BOK" ) == 0 ) {    
    // 0 : BOK     (국고)
    offset = 20;
    inlen = 28;
  } else {
    // 1 : NEW BOK (신한은망)
    offset = 16;
    inlen = 32;
  }

  memset(gc_PlainIdPswd, 0x0, sizeof( gc_PlainIdPswd ) );

  // 20200408 : Encrypt 안 할 경우
  if( g_Encrypt_Flag == 0 ) {
    memcpy( gc_PlainIdPswd, gc_EncIdPswd, strlen( gc_EncIdPswd ) );

    // copy id, pswd
    memset( gc_plain_id, 0, 	    sizeof( gc_plain_id ) );
    memset( gc_plain_pw, 0, 	    sizeof( gc_plain_pw ) );

    memcpy( gc_plain_id, gc_PlainIdPswd, 	    offset );
    memcpy( gc_plain_pw, gc_PlainIdPswd+offset, inlen-offset );

    return 0;
  }

  rc = inl_decrypt(gc_EncIdPswd, inlen, (char**)&pOut, &outlen);
  if( rc < 0 )
  {
    ulog(_ERROR_, "[장애로그] : ID/PSWD Decrypt 오류 BIZ[%s] [%d]", gc_BizCode, rc);
    return -2;
  }

  // copy encrypted id, pswd
  memcpy( gc_PlainIdPswd, pOut, outlen );

  // copy id, pswd
  memset( gc_plain_id, 0, 	    sizeof( gc_plain_id ) );
  memset( gc_plain_pw, 0, 	    sizeof( gc_plain_pw ) );

  memcpy( gc_plain_id, gc_PlainIdPswd, 	    offset );
  memcpy( gc_plain_pw, gc_PlainIdPswd+offset, inlen-offset );

  return 0;
}

int	lf_GetSlsDt( char *Slsdate )
{
	int        nRtryCnt = 0 ;

  EXEC SQL BEGIN DECLARE SECTION;
  char    vcSlsDate[32+1];
  EXEC SQL END DECLARE SECTION;

  memset( vcSlsDate, 0x00, sizeof( vcSlsDate ) );
  memset( Slsdate, 0x00, sizeof( Slsdate ) );


 // TODO : TABLE NAME 확인 필요
	while (1){
		EXEC SQL SELECT  SLS_DT
			INTO    :vcSlsDate
			FROM    TB_AA_M_SLS_DT@DL_DBUAP_SMS
			;

		if (SQLCODE != SQL_OK) { 
			if (nRtryCnt < 1) { 
				roLog(_WARNING_, "[%s] 영업일자 취득 실패. "
								 "(SqlCode=%d, nRtryCnt=%d) -> 1초 후 재시도."
								, __FUNCTION__, SQLCODE, nRtryCnt);
				sleep(1);
				nRtryCnt++;
        continue;
			} 

			roLog(_ERROR_, "[%s] 영업일자 취득 실패. "                 
								 "(SqlCode=%d, nRtryCnt=%d) -> Error 리턴."          
								, __FUNCTION__, SQLCODE, nRtryCnt);                  
      return -1;
		} 

		roLog(_WARNING_, "[%s] 영업일자 취득 OK. (SlsDate=%.*s)"
							, __FUNCTION__, strlen(vcSlsDate), vcSlsDate);
		memcpy(Slsdate, vcSlsDate, strlen(vcSlsDate));
		break; 
	}

  return 0;
}
